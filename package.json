{
  "name": "local-build-desk",
  "version": "0.1.10",
  "description": "Build and submit Expo apps from your Mac",
  "private": true,
  "type": "module",
  "main": "out/main/index.js",
  "bin": {
    "ios-submit": "bin/ios-submit.mjs"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build && tsup src/cli/index.ts --format esm --platform node --target node24 --out-dir out/cli --external electron --external plist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "cli": "tsx src/cli/index.ts",
    "package": "npm run build && electron-builder --mac dir",
    "test:ui": "npm run build && playwright test",
    "format": "prettier --write src tests *.ts *.json README.md",
    "release:mac": "npm run build && electron-builder --config electron-builder.release.cjs --mac --publish never"
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.2.8",
    "@fontsource/ibm-plex-mono": "^5.2.7",
    "electron-updater": "^6.8.11",
    "jose": "^6.1.0",
    "lucide-react": "^0.577.0",
    "plist": "^3.1.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "xcode": "^4.0.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@resvg/resvg-js": "^2.6.2",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.0.0",
    "@types/plist": "^3.0.5",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/xcode": "^3.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vitest": "^4.1.0"
  },
  "build": {
    "appId": "com.boyerlabs.localbuilddesk",
    "productName": "Local Build Desk",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/main/**/*",
      "out/preload/**/*",
      "out/renderer/**/*",
      "out/cli/**/*",
      "package.json"
    ],
    "mac": {
      "target": "dir",
      "category": "public.app-category.developer-tools",
      "identity": null,
      "icon": "resources/icon.icns"
    },
    "asar": true,
    "publish": [
      {
        "provider": "github",
        "owner": "KyleBoyer",
        "repo": "local-build-desk",
        "releaseType": "release"
      }
    ]
  },
  "author": "Boyer Labs",
  "engines": {
    "node": ">=24"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KyleBoyer/local-build-desk.git"
  },
  "homepage": "https://github.com/KyleBoyer/local-build-desk#readme",
  "bugs": {
    "url": "https://github.com/KyleBoyer/local-build-desk/issues"
  }
}
